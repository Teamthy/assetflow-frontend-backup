import { z } from 'zod'

export const branchSchema = z.object({
  name: z.string().min(2, 'Branch name is required').max(150),
  code: z
    .string()
    .optional()
    .or(z.literal(''))
    .refine((value) => !value || value.trim().length === 0 || value.trim().length >= 2, {
      message: 'Branch code must be at least 2 characters',
    }),
  description: z.string().max(500).optional().or(z.literal('')),
})

export type BranchFormValues = z.input<typeof branchSchema>
