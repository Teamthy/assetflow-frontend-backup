'use client'

import { useQuery } from '@tanstack/react-query'
import { ClipboardCheck } from 'lucide-react'
import { PageHeader } from '@/components/shared/PageHeader'
import apiClient from '@/lib/api/client'

export default function AuditCampaignsPage() {
  const { data, isLoading, isError } = useQuery({
    queryKey: ['audit-campaigns'],
    queryFn: async () => {
      const response = await apiClient.get('/audit/campaigns')
      return response.data?.data ?? response.data ?? []
    },
  })

  const items = Array.isArray(data) ? data : data?.items ?? data?.data ?? []

  return (
    <div className="space-y-6">
      <PageHeader
        title="Physical audit"
        description="Campaigns and verifications for stock-take and auditor walkthroughs"
      />
      {isLoading ? (
        <p className="text-sm text-slate-500">Loading campaigns…</p>
      ) : isError ? (
        <p className="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          Audit campaigns are not ready yet. Run <code>pnpm db:migrate</code> on the API if this persists.
        </p>
      ) : items.length === 0 ? (
        <div className="rounded-xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500">
          <ClipboardCheck className="mx-auto mb-3 h-8 w-8 text-slate-400" />
          No audit campaigns yet. Create one when you run a physical verification.
        </div>
      ) : (
        <div className="divide-y rounded-xl border border-slate-200 bg-white">
          {items.map((campaign: { id: string; name?: string; status?: string }) => (
            <div key={campaign.id} className="flex items-center justify-between px-4 py-3 text-sm">
              <span className="font-medium text-slate-900">{campaign.name ?? campaign.id}</span>
              <span className="text-slate-500">{campaign.status ?? 'draft'}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  )
}
