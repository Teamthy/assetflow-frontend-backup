# Local
NEXT_PUBLIC_API_URL=http://127.0.0.1:7000/api
NEXT_PUBLIC_APP_NAME=AssetFlow
NEXT_PUBLIC_ENFORCE_RBAC=false

# Vercel production — set these in the Vercel project, not in git
# NEXT_PUBLIC_API_URL=https://YOUR-API-HOST/api
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# NEXT_PUBLIC_ENFORCE_RBAC=false

# Optional same-origin BFF in Next. Prefer this in the browser:
# NEXT_PUBLIC_API_URL=/backend/api
# API_PROXY_TARGET=http://127.0.0.1:7000
